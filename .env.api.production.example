# Ambiente da API publicada em api.j12sports.com.br
NODE_ENV=production
HOST=127.0.0.1
PORT=4001
CORS_ALLOWED_ORIGINS=https://app.j12sports.com.br
HEALTH_SHOW_DETAILS=false
APP_BASE_URL=https://app.j12sports.com.br

# Envio real de e-mail para recuperacao de senha
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=nao-responda@j12sports.com.br
RESEND_FROM_NAME=J12 Sports
