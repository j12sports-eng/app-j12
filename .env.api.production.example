# Ambiente da API publicada em api.j12sports.com.br
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
CORS_ALLOWED_ORIGINS=https://app.j12sports.com.br
HEALTH_SHOW_DETAILS=false
APP_BASE_URL=https://app.j12sports.com.br

# Autenticacao
JWT_SECRET=<EXAMPLE_ONLY_NOT_A_REAL_SECRET>
JWT_EXPIRES=24h

# Banco MySQL. Use DATABASE_URL ou os campos DB_*.
DATABASE_URL=
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Envio real de e-mail para recuperacao de senha
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=nao-responda@j12sports.com.br
RESEND_FROM_NAME=J12 Sports

# Banco Inter - PIX producao
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_CERT_PATH=/home/app/certs/Inter API_Certificado
INTER_KEY_PATH=/home/app/certs/Inter API_Chave
INTER_BASE_URL=https://cdpj.partners.bancointer.com.br
INTER_WEBHOOK_URL=https://api.j12sports.com.br/api/webhooks/inter
INTER_PIX_KEY=
INTER_WEBHOOK_SECRET=

# BotConversa - WhatsApp automatico financeiro
BOTCONVERSA_WEBHOOK_URL=
BOTCONVERSA_API_KEY=

# Bootstrap de contas de demonstracao: desabilitado por padrao.
AUTH_SEED_ENABLED=false
AUTH_SEED_ADMIN_PASSWORD=<EXAMPLE_ONLY_NOT_A_REAL_PASSWORD>
AUTH_SEED_COORDENADOR_PASSWORD=<EXAMPLE_ONLY_NOT_A_REAL_PASSWORD>
AUTH_SEED_PROFESSOR_PASSWORD=<EXAMPLE_ONLY_NOT_A_REAL_PASSWORD>
AUTH_SEED_ALUNO_PASSWORD=<EXAMPLE_ONLY_NOT_A_REAL_PASSWORD>
AUTH_SEED_RESPONSAVEL_PASSWORD=<EXAMPLE_ONLY_NOT_A_REAL_PASSWORD>
