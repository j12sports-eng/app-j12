# Template only. Copy to a secret-managed file outside Git.
J12_ENVIRONMENT=hml
HML_ISOLATED=true
HML_INSTANCE_ID=hml-local-disposable
HML_PUBLIC_URL=https://hml.invalid
HML_API_URL=http://127.0.0.1:3101

NODE_ENV=production
HOST=127.0.0.1
PORT=3101
CORS_ORIGIN=https://hml.invalid
APP_BASE_URL=https://hml.invalid

DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=j12_hml
DB_PASSWORD=<GENERATE_OUTSIDE_GIT>
DB_NAME=j12_sports_hml
MYSQL_ROOT_PASSWORD=<GENERATE_OUTSIDE_GIT>

JWT_SECRET=<GENERATE_AT_LEAST_32_RANDOM_CHARACTERS_OUTSIDE_GIT>
AUTH_SEED_ENABLED=false

# Outbound integrations are fail-closed. Enable only a specifically approved sandbox.
HML_REAL_INTEGRATIONS_ENABLED=false
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
RESEND_FROM_EMAIL=
BOTCONVERSA_WEBHOOK_URL=
BOTCONVERSA_API_KEY=
N8N_BASE_URL=
N8N_WEBHOOK_URL=
INTER_INTEGRATION_MODE=disabled
INTER_BASE_URL=https://sandbox.invalid
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_CERT_PATH=certs/hml/inter-sandbox.crt
INTER_KEY_PATH=certs/hml/inter-sandbox.key
INTER_PIX_KEY=
INTER_WEBHOOK_URL=https://hml.invalid/api/webhooks/inter
INTER_WEBHOOK_SECRET=<GENERATE_OUTSIDE_GIT>

