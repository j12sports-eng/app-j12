{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "cd backend && node server.js",
    "dev:web": "vite dev --host 127.0.0.1 --port 3000",
    "dev:all": "node scripts/dev-local.mjs",
    "dev:server": "node server/index.mjs",
    "dev:mysql-api": "cmd /c npm --prefix backend run dev",
    "start": "node scripts/serve-ssr.mjs --host 127.0.0.1 --port 4173",
    "start:prod": "node scripts/serve-ssr.mjs --host 127.0.0.1 --port 4173 --api-target http://127.0.0.1:3001",
    "start:api": "node server/index.mjs",
    "start:api:prod": "node --env-file=.env server/index.mjs",
    "start:frontend": "node scripts/serve-ssr.mjs --host 127.0.0.1 --port 4173",
    "start:mysql-api": "cmd /c npm --prefix backend start",
    "dev:stop": "powershell -ExecutionPolicy Bypass -File scripts/stop-local.ps1",
    "build": "node scripts/build.mjs",
    "build:dev": "vite build --mode development",
    "deploy": "npm run build && npm run pm2:start",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 reload ecosystem.config.cjs --update-env",
    "pm2:stop": "pm2 stop j12-api j12-frontend",
    "pm2:logs": "pm2 logs j12-api j12-frontend",
    "preview": "node scripts/serve-ssr.mjs --host 127.0.0.1 --port 4173",
    "lint": "eslint .",
    "format": "prettier --write .",
    "ci:lint:baseline": "node scripts/ci/eslint-baseline.cjs",
    "ci:test:contracts": "node --test scripts/ci/*.test.cjs deploy/almalinux/atomic-deploy.contract.test.cjs",
    "ci:test:security": "node scripts/ci/test-suites.cjs security",
    "ci:test:migrations": "node scripts/ci/test-suites.cjs migrations",
    "ci:test:frontend": "node scripts/ci/test-suites.cjs frontend",
    "ci:quality:changed": "node scripts/ci/changed-quality.cjs",
    "ci:secrets": "node scripts/ci/secret-scan.cjs",
    "ci:test:backend": "node scripts/ci/test-suites.cjs backend",
    "e2e:23.11:preflight": "node scripts/e2e/sprint-23-11-preflight.cjs",
    "e2e:23.11": "playwright test --config=playwright.config.cjs",
    "e2e:23.11:inspect": "node scripts/e2e/sprint-23-11-runner.cjs --inspect-only",
    "e2e:23.11:local": "node scripts/e2e/sprint-23-11-runner.cjs --apply-local-migrations"
  },
