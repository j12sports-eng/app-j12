{
  "name": "J12 Financeiro - Lembretes de Vencimento",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "id": "financeiro-lembretes-trigger",
      "name": "Trigger Diario 08h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "={{$env.J12_API_URL}}/api/admin/financeiro/automation/vencimentos",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "days",
              "value": "0,1,3,7"
            },
            {
              "name": "limit",
              "value": "200"
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "financeiro-lembretes-buscar",
      "name": "HTTP Buscar Vencimentos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0],
      "retryOnFail": true,
      "maxTries": 4,
      "waitBetweenTries": 2000,
      "continueOnFail": true,
      "credentials": {
        "httpHeaderAuth": {
          "name": "J12 Automation Service Token"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{!$json.error && Array.isArray(($json.body || $json).data?.items) && (($json.body || $json).data.items.length > 0)}}",
              "value2": true
            }
          ]
        }
      },
      "id": "financeiro-lembretes-if-consulta",
      "name": "IF Existem Vencimentos",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [480, 0]
    },
    {
      "parameters": {
        "jsCode": "const response = $json.body || $json; const items = response.data?.items || []; return items.map((item) => ({ json: { ...item, workflowName: 'financeiro-lembretes', eventType: 'LEMBRETE_ENVIADO', targetType: 'MENSALIDADE', targetId: item.mensalidadeId || item.id, eventKey: item.automation?.eventKey, referenceDate: item.vencimento, daysOffset: item.daysOffset, channel: 'whatsapp', provider: 'botconversa' } }));"
      },
      "id": "financeiro-lembretes-preparar",
      "name": "Preparar Itens",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, -120]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "financeiro-lembretes-loop",
      "name": "Loop Registros",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [960, -120]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.automation?.previouslyProcessed === true || $json.automation?.canSend === false || !$json.eventKey}}",
              "value2": true
            }
          ]
        }
      },
      "id": "financeiro-lembretes-if-idempotencia",
      "name": "IF Ignorar Idempotencia",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1200, -120]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.BOTCONVERSA_URL}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { event: 'financeiro_lembrete_vencimento', telefone: $json.responsavel?.telefone || $json.aluno?.telefone, email: $json.responsavel?.email || $json.aluno?.email, aluno: $json.aluno?.nome, responsavel: $json.responsavel?.nome, valor: $json.valor, vencimento: $json.vencimento, diasParaVencimento: $json.daysOffset, mensagem: `Ola, este e um lembrete da J12 Sports: a mensalidade de ${$json.aluno?.nome || 'aluno'} vence ${$json.daysOffset === 0 ? 'hoje' : `em ${$json.daysOffset} dia(s)`}.` } }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "financeiro-lembretes-enviar",
      "name": "HTTP Enviar WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1440, 0],
      "retryOnFail": true,
      "maxTries": 4,
      "waitBetweenTries": 2000,
      "continueOnFail": true,
      "credentials": {
        "httpHeaderAuth": {
          "name": "BotConversa API Token"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{!$json.error && (($json.statusCode || 200) < 400)}}",
              "value2": true
            }
          ]
        }
      },
      "id": "financeiro-lembretes-if-envio",
      "name": "IF Envio OK",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1680, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.J12_API_URL}}/api/admin/financeiro/automation/eventos",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { eventType: $('Loop Registros').item.json.eventType, targetType: $('Loop Registros').item.json.targetType, targetId: $('Loop Registros').item.json.targetId, eventKey: $('Loop Registros').item.json.eventKey, referenceDate: $('Loop Registros').item.json.referenceDate, daysOffset: $('Loop Registros').item.json.daysOffset, channel: 'whatsapp', provider: 'botconversa', status: 'COMPLETED', payload: { workflow: 'financeiro-lembretes', executionId: $execution.id } } }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "financeiro-lembretes-registrar-sucesso",
      "name": "HTTP Registrar Evento",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1920, -80],
      "retryOnFail": true,
      "maxTries": 4,
      "waitBetweenTries": 2000,
      "continueOnFail": true,
      "credentials": {
        "httpHeaderAuth": {
          "name": "J12 Automation Service Token"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.J12_API_URL}}/api/admin/financeiro/automation/eventos",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { eventType: 'ERRO_ENVIO', targetType: $('Loop Registros').item.json.targetType, targetId: $('Loop Registros').item.json.targetId, eventKey: `${$('Loop Registros').item.json.eventKey}:erro:${$execution.id}`, referenceDate: $('Loop Registros').item.json.referenceDate, daysOffset: $('Loop Registros').item.json.daysOffset, channel: 'whatsapp', provider: 'botconversa', status: 'FAILED', errorMessage: $json.error?.message || $json.body?.message || 'Falha no envio do lembrete', payload: { workflow: 'financeiro-lembretes', executionId: $execution.id } } }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "financeiro-lembretes-registrar-erro",
      "name": "HTTP Registrar Erro",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1920, 120],
      "retryOnFail": true,
      "maxTries": 4,
      "waitBetweenTries": 2000,
      "continueOnFail": true,
      "credentials": {
        "httpHeaderAuth": {
          "name": "J12 Automation Service Token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { workflow: 'financeiro-lembretes', status: 'sem_registros', executionId: $execution.id, processedAt: new Date().toISOString() } }];"
      },
      "id": "financeiro-lembretes-log-vazio",
      "name": "Log Sem Registros",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 160]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { workflow: 'financeiro-lembretes', status: 'encerrado', executionId: $execution.id, processedAt: new Date().toISOString() } }];"
      },
      "id": "financeiro-lembretes-log-fim",
      "name": "Log Encerramento",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 160]
    }
  ],
  "connections": {
    "Trigger Diario 08h": {
      "main": [
        [
          {
            "node": "HTTP Buscar Vencimentos",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Buscar Vencimentos": {
      "main": [
        [
          {
            "node": "IF Existem Vencimentos",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF Existem Vencimentos": {
      "main": [
        [
          {
            "node": "Preparar Itens",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Sem Registros",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Preparar Itens": {
      "main": [
        [
          {
            "node": "Loop Registros",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Loop Registros": {
      "main": [
        [
          {
            "node": "IF Ignorar Idempotencia",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Encerramento",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF Ignorar Idempotencia": {
      "main": [
        [
          {
            "node": "Loop Registros",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "HTTP Enviar WhatsApp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Enviar WhatsApp": {
      "main": [
        [
          {
            "node": "IF Envio OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF Envio OK": {
      "main": [
        [
          {
            "node": "HTTP Registrar Evento",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "HTTP Registrar Erro",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Registrar Evento": {
      "main": [
        [
          {
            "node": "Loop Registros",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Registrar Erro": {
      "main": [
        [
          {
            "node": "Loop Registros",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Sao_Paulo",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  },
  "active": false,
  "meta": {
    "templateCredsSetupCompleted": false,
    "description": "Execução diária para consultar vencimentos, enviar lembretes e registrar o resultado na API J12."
  },
  "versionId": "sprint-20-3-fase-b-lembretes"
}
