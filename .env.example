# URL da API usada pelo frontend.
# Em desenvolvimento local, use a API Express + MySQL em backend/server.js.
VITE_API_URL=http://localhost:3001
VITE_API_BASE_URL=http://localhost:3001

# API / autenticacao
NODE_ENV=development
JWT_SECRET=<EXAMPLE_ONLY_NOT_A_REAL_SECRET>
JWT_EXPIRES=24h

# Banco MySQL. Use DATABASE_URL ou os campos DB_*.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=3306
DB_USER=j12_user
DB_PASSWORD=
DB_NAME=j12_sports

# URL interna usada somente pelo SSR no Node.
SSR_API_URL=http://127.0.0.1:3001
API_BASE_URL=http://127.0.0.1:3001

# API Express + MySQL usada por alunos e financeiro.
VITE_MYSQL_API_URL=http://localhost:3001

# URL publica do app usada nos links enviados por e-mail.
APP_BASE_URL=http://localhost:3000

# Provedor de envio real de e-mail.
# Valores suportados: disabled | resend
EMAIL_PROVIDER=disabled

# Credenciais para envio real via Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=J12 Sports

# Banco Inter - PIX
# Homologacao: configure INTER_BASE_URL para o endpoint sandbox informado no portal do Banco Inter.
# Producao: https://cdpj.partners.bancointer.com.br
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_CERT_PATH=certs/inter.crt
INTER_KEY_PATH=certs/inter.key
INTER_BASE_URL=https://cdpj.partners.bancointer.com.br
INTER_WEBHOOK_URL=http://localhost:3001/api/webhooks/inter
INTER_PIX_KEY=
INTER_WEBHOOK_SECRET=

# BotConversa - WhatsApp automatico financeiro
BOTCONVERSA_WEBHOOK_URL=
BOTCONVERSA_API_KEY=

# Bootstrap de contas de demonstracao: desabilitado por padrao.
AUTH_SEED_ENABLED=false
AUTH_SEED_ADMIN_PASSWORD=<EXAMPLE_ONLY_NOT_A_REAL_PASSWORD>
AUTH_SEED_COORDENADOR_PASSWORD=<EXAMPLE_ONLY_NOT_A_REAL_PASSWORD>
AUTH_SEED_PROFESSOR_PASSWORD=<EXAMPLE_ONLY_NOT_A_REAL_PASSWORD>
AUTH_SEED_ALUNO_PASSWORD=<EXAMPLE_ONLY_NOT_A_REAL_PASSWORD>
AUTH_SEED_RESPONSAVEL_PASSWORD=<EXAMPLE_ONLY_NOT_A_REAL_PASSWORD>
